{
    "manifest_version": 3,
    "name": "Datalist Spike",
    "description": "Injects a datalist into input fields to probe Safari's QuickType bar.",
    "version": "1.0",
    "icons": {
        "48": "icon-48.png",
        "96": "icon-96.png",
        "128": "icon-128.png",
        "256": "icon-256.png",
        "512": "icon-512.png"
    },
    "background": {
        "scripts": [ "background.js" ],
        "type": "module"
    },
    "content_scripts": [{
        "js": [ "content.js" ],
        "matches": [ "<all_urls>" ],
        "all_frames": true,
        "run_at": "document_end"
    }],
    "action": {
        "default_icon": "toolbar-icon.svg"
    },
    "permissions": [ "nativeMessaging" ]
}
