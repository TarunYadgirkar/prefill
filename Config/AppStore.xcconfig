// Fill in the paid Apple Developer team ID before archiving for the App Store.
// Simulator builds work while it is empty.
#include "Cloud.xcconfig"
APP_STORE_TEAM_ID =
DEVELOPMENT_TEAM = $(APP_STORE_TEAM_ID)
PREFILL_BUNDLE_ID = com.tarunyadgirkar.prefill
PREFILL_SHARED_ENTITLEMENTS = Config/AppStore.entitlements
PREFILL_CLOUD_SYNC = YES
