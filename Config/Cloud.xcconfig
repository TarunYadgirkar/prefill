// iCloud sync of sent applications (AppCloud/). PREFILL_CLOUD_SYNC is YES for a build the paid
// team signs (5AKJYZ7USP is paid since Oct 14); set it to NO to build without iCloud. These pick
// the app's entitlements and the Swift flag from it.
PREFILL_APP_ENTITLEMENTS_NO = $(PREFILL_SHARED_ENTITLEMENTS)
PREFILL_APP_ENTITLEMENTS_YES = $(PREFILL_CLOUD_ENTITLEMENTS)
PREFILL_APP_ENTITLEMENTS = $(PREFILL_APP_ENTITLEMENTS_$(PREFILL_CLOUD_SYNC))
PREFILL_MAC_ENTITLEMENTS_NO = MacApp/Prefill.entitlements
PREFILL_MAC_ENTITLEMENTS_YES = MacApp/PrefillCloud.entitlements
PREFILL_MAC_ENTITLEMENTS = $(PREFILL_MAC_ENTITLEMENTS_$(PREFILL_CLOUD_SYNC))
PREFILL_CLOUD_CONDITION_NO =
PREFILL_CLOUD_CONDITION_YES = PREFILL_CLOUD
PREFILL_CLOUD_CONDITION = $(PREFILL_CLOUD_CONDITION_$(PREFILL_CLOUD_SYNC))
