// Development build for Tarun's own iPhone and Mac, signed by his team (paid since Oct 14, so
// its profiles last a year). Its own .dev bundle IDs keep the plain IDs free for the App Store.
#include "Cloud.xcconfig"
DEVELOPMENT_TEAM = 5AKJYZ7USP
PREFILL_BUNDLE_ID = com.tarunyadgirkar.prefill.dev
PREFILL_SHARED_ENTITLEMENTS = Config/Personal.entitlements
PREFILL_CLOUD_ENTITLEMENTS = Config/PersonalCloud.entitlements
PREFILL_CLOUD_SYNC = YES
