<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Where Google sends the browser back after Connect Google Sheets: the reversed ID of
	     Prefill's OAuth client (GoogleAccount.clientID). -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>Google sign-in</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>com.googleusercontent.apps.954823334855-u2fe0qpv01c43s86iit84ccfp93o0vem</string>
			</array>
		</dict>
	</array>
	<!-- Sparkle: where a release looks for updates (empty in builds from Xcode) and the public
	     half of the signing key in Tarun's login keychain (account "prefill"). -->
	<key>SUFeedURL</key>
	<string>$(PREFILL_FEED_URL)</string>
	<key>SUPublicEDKey</key>
	<string>twr888AyzSaGoRSP2ShhPfZ0X7ir0iPY1T3NeqAWTrY=</string>
	<key>SUEnableAutomaticChecks</key>
	<true/>
</dict>
</plist>
