<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>PrefillAppGroup</key>
	<string>$(PREFILL_APP_GROUP)</string>
	<!-- Lets iCloud wake the app when the Mac sends an application (AppCloud/). It does
	     nothing in a build without push, the free team's. -->
	<key>UIBackgroundModes</key>
	<array>
		<string>remote-notification</string>
	</array>
	<key>PrefillKeyboardGroup</key>
	<string>$(PREFILL_KEYBOARD_GROUP)</string>
	<key>PrefillKeychainGroup</key>
	<string>$(PREFILL_KEYCHAIN_GROUP)</string>
</dict>
</plist>
